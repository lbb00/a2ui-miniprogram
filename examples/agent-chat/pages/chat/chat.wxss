.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部栏 */
.chat-header {
  height: 88rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
  flex-shrink: 0;
  z-index: 10;
}

.agent-status-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.status-dot.online {
  background-color: #10b981;
  box-shadow: 0 0 8rpx #10b981;
}

.status-dot.busy {
  background-color: #f59e0b;
  box-shadow: 0 0 8rpx #f59e0b;
  animation: pulse-busy 1s infinite alternate;
}

@keyframes pulse-busy {
  0% { opacity: 0.4; }
  100% { opacity: 1; }
}

.status-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}

.header-actions {
  display: flex;
  align-items: center;
}

.header-btn {
  margin: 0 !important;
  padding: 6rpx 18rpx !important;
  height: 54rpx !important;
  line-height: 42rpx !important;
  background-color: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #334155;
  display: inline-flex;
  align-items: center;
}

.header-btn::after {
  border: none;
}

.btn-hover {
  background-color: #e2e8f0;
}

.btn-icon {
  margin-right: 6rpx;
}

/* 芯片栏 */
.chips-scroll {
  white-space: nowrap;
  background-color: #ffffff;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.chip-item {
  display: inline-flex;
  align-items: center;
  background-color: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 30rpx;
  padding: 8rpx 22rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: #4338ca;
  font-weight: 500;
}

.chip-hover {
  background-color: #e0e7ff;
}

.chip-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* 消息流 */
.messages-scroll {
  flex: 1;
  height: 0; /* 关键：设置 height: 0 让 flex: 1 真正接管高度，避免子元素撑开导致无法滚动 */
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.messages-list {
  padding: 24rpx 24rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
}

.agent-avatar {
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  margin-right: 18rpx;
}

.user-avatar {
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  margin-left: 18rpx;
}

.avatar-icon {
  font-size: 36rpx;
}

.msg-user {
  justify-content: flex-end;
}

.user-bubble {
  background: linear-gradient(135deg, #4f46e5, #4338ca);
  color: #ffffff;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  padding: 20rpx 28rpx;
  max-width: 72%;
  box-shadow: 0 4rpx 14rpx rgba(79, 70, 229, 0.25);
}

.user-text {
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.msg-assistant {
  justify-content: flex-start;
}

.agent-content-col {
  display: flex;
  flex-direction: column;
  max-width: 84%;
  gap: 14rpx;
}

.thinking-box {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  background-color: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  gap: 10rpx;
}

.thinking-spinner {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #c7d2fe;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.thinking-icon {
  font-size: 20rpx;
}

.thinking-text {
  font-size: 22rpx;
  color: #64748b;
  font-style: italic;
}

.agent-bubble {
  background-color: #ffffff;
  color: #1e293b;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  padding: 22rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.agent-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.typing-cursor {
  display: inline-block;
  color: #4f46e5;
  font-weight: bold;
  animation: blink 0.8s infinite;
  margin-left: 4rpx;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* A2UI 卡片容器 */
.a2ui-card-wrapper {
  width: 100%;
  margin-top: 8rpx;
  box-sizing: border-box;
}

/* Action 反馈条 */
.msg-action {
  justify-content: center;
  margin: 12rpx 0;
}

.action-pill {
  background-color: #f1f5f9;
  color: #64748b;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.scroll-bottom-anchor {
  height: 10rpx;
}

/* 底部输入栏 */
.chat-input-bar {
  background-color: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)) 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
  will-change: margin-bottom;
}

.input-wrapper {
  flex: 1;
  background-color: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
}

.chat-input {
  width: 100%;
  font-size: 28rpx;
  color: #1e293b;
  height: 48rpx;
}

.send-btn {
  margin: 0 !important;
  background: linear-gradient(135deg, #4f46e5, #4338ca);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  height: 72rpx !important;
  line-height: 72rpx !important;
  padding: 0 32rpx !important;
}

.send-btn::after {
  border: none;
}

.send-btn.disabled {
  background: #cbd5e1;
  color: #94a3b8;
}

.send-btn-hover {
  opacity: 0.9;
}
